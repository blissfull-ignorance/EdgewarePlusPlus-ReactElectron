{
  "name": "edgeware-plusplus-electron",
  "version": "20.0.0",
  "description": "Cross-platform Edgeware++ built with React, Mantine, Vite, and Electron",
  "main": "electron-dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -p tsconfig.electron.json && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p tsconfig.electron.json && vite build && playwright test",
    "test:e2e:ui": "tsc -p tsconfig.electron.json && vite build && playwright test --ui"
  },
  "dependencies": {
    "@mantine/core": "^7",
    "@mantine/hooks": "^7",
    "@tabler/icons-react": "^3",
    "@types/discord-rpc": "^4.0.11",
    "adm-zip": "^0.5.18",
    "discord-rpc": "^4.0.1",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.3",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "zustand": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9",
    "electron": "^33",
    "electron-builder": "^25",
    "typescript": "^5.7",
    "vite": "^6",
    "vite-plugin-electron": "^0.28",
    "vitest": "^4.1.10",
    "wait-on": "^8"
  },
  "build": {
    "appId": "com.mistresscalia.edgewareplusplus",
    "productName": "Edgeware++",
    "files": [
      "electron-dist/**/*",
      "electron/preload.cjs",
      "dist/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "electron/preload.cjs"
    ],
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.icns",
      "entitlements": "build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    }
  }
}
